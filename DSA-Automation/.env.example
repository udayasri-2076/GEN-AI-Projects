# ---- Database (Neon / Supabase / local Postgres) ----
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- GitHub ----
GITHUB_TOKEN=            # fine-grained token with Contents: read/write on the two repos
GITHUB_OWNER=            # your GitHub username
LEETCODE_REPO=           # repo LeetCode pushes to (name only)
DSA_REPO=                # repo where notes/solutions are committed (name only)
GITHUB_WEBHOOK_SECRET=   # same secret you set in the GitHub webhook settings

# ---- Gemini ----
GEMINI_API_KEY=
# GEMINI_MODEL=          # optional override

# ---- Protect the review dashboard ----
REVIEW_USERNAME=admin
REVIEW_PASSWORD=         # choose a long random password

# ---- Notifications (Telegram) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUBLIC_BASE_URL=https://your-app.onrender.com
